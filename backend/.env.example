# ──────────────────────────────────────────────────────────────────────────────
# Onsite — backend env (copy to .env and fill in)
# ──────────────────────────────────────────────────────────────────────────────

# Port the Express server listens on. Default 3001.
PORT=3001

# Production indicator. Enables: trust-proxy (X-Forwarded-* from Render/etc),
# HSTS header, stricter behavior. Leave unset locally.
# NODE_ENV=production

# JWT secret — REQUIRED in production. Use a 64+ char random string. Tokens
# signed with one secret are invalid under another, so rotating logs
# everyone out.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Locally a stable secret is auto-persisted to backend/data/.jwt-secret if
# you don't set this.
# JWT_SECRET=your-64-char-random-secret-here

# JWT expiry. Defaults to 7d. Use any vercel/ms duration string (e.g. "1d",
# "12h", "30d"). Shorter = safer, but users sign in more often.
# JWT_EXPIRES_IN=7d

# Lock CORS to a single origin in production (e.g. your GitHub Pages URL).
# In dev, leaving this unset allows all origins so the Vite proxy works.
# FRONTEND_ORIGIN=https://<username>.github.io

# Anthropic API key for AI answer grading in mock interviews. When unset,
# /api/ai/health returns { enabled: false } and the frontend hides the
# AI-check button — so the rest of the app keeps working without it.
# This key NEVER leaves the server: the frontend posts the user's answer to
# /api/ai/grade, the server fetches the reference answer from SQLite, calls
# Anthropic with claude-haiku-4-5, and returns a structured grade.
# Get a key at https://console.anthropic.com/. Keep it secret.
# ANTHROPIC_API_KEY=sk-ant-...

# ──────────────────────────────────────────────────────────────────────────────
# Admin / billing
# ──────────────────────────────────────────────────────────────────────────────

# Email of the very first admin. On boot, that user (if registered) gets
# is_admin = 1 automatically. Leave unset after the first admin exists —
# subsequent admins are promoted from the dashboard.
# ADMIN_BOOTSTRAP_EMAIL=you@example.com

# AI grader daily quotas. Per-user (signed-in, free plan) and per-IP (anon).
# Pro / lifetime users skip these caps entirely.
# FREE_AI_GRADES_PER_DAY=10
# ANON_AI_GRADES_PER_DAY=3

# Pro is not on sale right now — see the BILLING_ENABLED note in billing.js.
# Leave this unset (or anything other than "true") and checkout refuses before
# it ever reaches Stripe, whatever the keys below say. The customer portal and
# the webhook stay live regardless, so an existing subscriber can still cancel
# and Stripe can still reconcile their tier.
# BILLING_ENABLED=true

# ── Stripe (optional). With these unset, /api/billing/* answers 503 and the
#    /pricing page hides the upgrade button cleanly.
# Get keys at https://dashboard.stripe.com/apikeys. Use a TEST key first.
# STRIPE_SECRET_KEY=sk_test_...
# Set up a Subscription product in Stripe → grab the Price id (price_...).
# STRIPE_PRICE_ID=price_...
# Webhook signing secret. Create a Stripe webhook pointing at
# POST /api/billing/webhook (events: checkout.session.completed,
# customer.subscription.updated, customer.subscription.deleted) and paste
# the signing secret here.
# STRIPE_WEBHOOK_SECRET=whsec_...
# Where Stripe sends the user after a successful checkout / cancel. Defaults
# to example.com in code, so set these in any deploy that uses billing.
# BILLING_SUCCESS_URL=https://your.app/?upgraded=1
# BILLING_CANCEL_URL=https://your.app/pricing

# ──────────────────────────────────────────────────────────────────────────────
# Web Push — daily "your SRS cards are due" reminders
# ──────────────────────────────────────────────────────────────────────────────
#
# VAPID is how the server proves to a browser's push service (FCM, Mozilla,
# Apple) that it is the same origin the user subscribed to. The keypair is
# self-generated — there is no account to create and no third party involved,
# which is why push was chosen over email here.
#
# Generate a keypair ONCE and keep it for the life of the deployment:
#
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
#
# Paste the two values below. Rotating them invalidates every existing
# subscription: browsers subscribe with the PUBLIC key baked in, so after a
# rotation every device silently stops receiving notifications until it
# re-subscribes. Treat the private key like JWT_SECRET.
#
# With these unset, /api/push/health returns { enabled: false } and every other
# /api/push/* route answers 503 — the rest of the app is unaffected.
# VAPID_PUBLIC_KEY=BB...   (87 chars, base64url — safe to ship to the browser)
# VAPID_PRIVATE_KEY=...    (43 chars, base64url — NEVER leaves the server)

# Contact URI push services use to reach whoever is sending. Must be a
# mailto: or https:// URI. Defaults to mailto:admin@example.com; set a real
# address on any deploy that actually sends.
# VAPID_SUBJECT=mailto:you@example.com

# Local-time send window, in the DEVICE's own timezone (each subscription
# stores the browser's UTC offset at subscribe time). Reminders go out at the
# first tick at or after PUSH_SEND_HOUR and never at or after PUSH_QUIET_HOUR.
# Defaults: 9 and 22.
# PUSH_SEND_HOUR=9
# PUSH_QUIET_HOUR=22

# Set to `off` to disable the in-process 15-minute timer and drive the job
# from an external cron instead:
#   curl -fsS -X POST https://your.api/api/push/run-daily -H "X-Cron-Secret: $SECRET"
# Both paths share the same once-per-day-per-device guard in SQLite, so
# running both at once is harmless.
# PUSH_DAILY_JOB=off

# Shared secret for that trigger endpoint, compared in constant time. Without
# it the endpoint accepts only an admin JWT — impractical for cron, since
# tokens expire. Generate like any other secret:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# PUSH_CRON_SECRET=...
